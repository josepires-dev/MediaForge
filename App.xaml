<?xml version="1.0" encoding="utf-8"?>
<Application
  x:Class="MediaForge.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  RequestedTheme="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="CanvasBrush" Color="#121316" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#1E2026" />
      <SolidColorBrush x:Key="WarmSurfaceBrush" Color="#2C221D" />
      <SolidColorBrush x:Key="InkBrush" Color="#F3F4F8" />
      <SolidColorBrush x:Key="MutedInkBrush" Color="#9EA7B4" />
      <SolidColorBrush x:Key="LineBrush" Color="#2C303A" />
      <SolidColorBrush x:Key="ConverterAccentBrush" Color="#8B70FF" />
      <SolidColorBrush x:Key="ConverterAccentSoftBrush" Color="#241D3B" />
      <SolidColorBrush x:Key="WarmAccentBrush" Color="#FF7A59" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
