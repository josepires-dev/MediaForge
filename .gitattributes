# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.cs text
*.xaml text
*.md text
*.json text
*.yml text
*.yaml text
*.ps1 text
*.sh text
*.bat text
*.cmd text
*.css text
*.js text
*.ts text
*.html text
*.xml text

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.exe binary
*.dll binary
*.msix binary
*.zip binary
*.7z binary